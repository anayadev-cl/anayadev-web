# anayadev-api — variables de entorno (copiar a .env y ajustar)

# Usuario y clave del panel admin del CMS (solo se usan en el primer arranque:
# quedan guardados en la base de datos. Cambiarlos acá no los rota).
ANAYADEV_ADMIN_USUARIO=admin
ANAYADEV_ADMIN_CLAVE=anayadev2026

# Secreto con el que se firman los tokens JWT del panel admin
ANAYADEV_SECRETO_JWT=cambia-este-secreto-en-produccion

# Orígenes permitidos por CORS (separados por coma)
ANAYADEV_CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Destino del formulario de contacto
ANAYADEV_EMAIL_DESTINO=hola@anayadev.cl

# SMTP para el envío de correos del formulario (opcional en desarrollo:
# sin ANAYADEV_SMTP_HOST el correo solo se registra en el log)
ANAYADEV_SMTP_HOST=
ANAYADEV_SMTP_PUERTO=587
ANAYADEV_SMTP_USUARIO=
ANAYADEV_SMTP_CLAVE=
ANAYADEV_SMTP_TLS=true

# API pública de Calenzia (solo lectura) para el catálogo del checkout.
# Los ajustes del CMS (Ajustes → API de Calenzia) sobrescriben estos valores
# cuando no están vacíos.
ANAYADEV_CALENZIA_API_URL=https://api.agenda.anayadev.cl
ANAYADEV_CALENZIA_PAISES_URL=https://api.agenda.anayadev.cl/api/v1/publico/paises
ANAYADEV_CALENZIA_PRECIOS_URL=https://api.agenda.anayadev.cl/api/v1/publico/precios?pais={pais}
