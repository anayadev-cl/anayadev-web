# ---- anayadev-web · .gitignore ----

# Secrets / entorno
.env
*.local

# Python / backend
__pycache__/
*.py[cod]
.venv/
api/data/

# Medios subidos localmente (no versionar binarios)
api/uploads/*
!api/uploads/.gitkeep

# Node / frontend
node_modules/
web/dist/

# Editores / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
*:Zone.Identifier

# Logs
*.log
